<%= turbo_stream.update "job_application_button_#{@job.id}" do %>
  <%= link_to "Cancel Application", cancel_application_job_path(@job), class: "action-buttons", data: { turbo_method: :delete } %>
<% end %>

<%= turbo_stream.replace "job_application_modal" do %>
  <turbo-frame id="job_application_modal"></turbo-frame>
<% end %>

<%= turbo_stream.append "notifications" do %>
  <%= render "shared/notification", message: "Successfully applied for the job", type: "info" %>
<% end %>
