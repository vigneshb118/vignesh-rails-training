<%= job.title %>
<%= job.description %>
<%= job.job_type %>
<%= job.salary %>
<% if policy(job).edit? %>
  <%= link_to "Edit", edit_job_path(job) %>
<% end %>
<% if policy(job).destroy? %>
  <%= link_to "Delete", job, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this job?" } %>
<% end %>