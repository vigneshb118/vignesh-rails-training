<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <%= link_to "Jobs", jobs_path, class: "navbar-brand" %>
    <% if current_user&.user_type == "employer" %>
    <% if current_user.company %>
      <%= link_to "My Company", company_path(current_user.company), class: "navbar-brand" %>
    <% else %>
      <%= link_to "New Company", new_company_path, class: "navbar-brand" %>
    <% end %>
    <% end %>
    <% if user_signed_in? %>
      <%= link_to "Sign Out", destroy_user_session_path, class: "navbar-brand", data: { turbo_method: :delete } %>
      <%= link_to "Edit Profile", edit_user_registration_path, class: "navbar-brand" %>
    <% else %>
    <% if controller_name == "sessions" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "navbar-brand" %>
    <% else %>
      <%= link_to "Sign In", new_user_session_path, class: "navbar-brand" %>
    <% end %>
    <% end %>
  </div>
</nav>