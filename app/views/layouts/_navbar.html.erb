<div class="navbar">
  <div class="container-fluid">
    <%= link_to "HireHub", root_path, class: "navbar-brand" %>
    <div class="flex items-center space-x-4">
      <%= link_to "Jobs", jobs_path, class: "navbar-link" %>
      <% if current_user&.user_type == "employer" %>
        <% if current_user.company %>
          <%= link_to "My Company", company_path(current_user.company), class: "navbar-link" %>
        <% else %>
          <%= link_to "New Company", new_company_path, class: "navbar-link" %>
        <% end %>
      <% end %>
      <% if user_signed_in? %>
        <%= link_to "Sign Out", destroy_user_session_path, class: "navbar-link", data: { turbo_method: :delete } %>
        <%= link_to "Edit Profile", edit_user_registration_path, class: "navbar-link" %>
      <% else %>
        <% if controller_name == "sessions" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "navbar-link" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "navbar-link" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
