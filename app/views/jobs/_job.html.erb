<div class="job-card">
<%= turbo_frame_tag "job_#{job.id}" do %>
  <a href="<%= job_path(job) %>" data-turbo-frame="_top"><h2><%= job.title %></h2></a> 
  <label><%= job.job_type.humanize.titleize %></label>
  <h3><%= job.company.name %></h3>
  <p><%= simple_format(truncate(job.description, length: 400, separator: ' ')) %></p>
<% end %>
</div>
