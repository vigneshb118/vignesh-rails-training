<%= turbo_frame_tag "job_#{job.id}" do %>
  <div data-controller="accordion" data-accordion-open-value="false" class="job-accordion">
    <button data-action="accordion#toggle" class="job-accordion-button">
      <span class="job-accordion-button-text"><%= job.title %><span class="job-accordion-button-text-type"><%= job.job_type.humanize.titleize %></span></span>
      <svg data-accordion-target="iconClosed" class="job-accordion-icon-closed" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <svg data-accordion-target="iconOpen" class="job-accordion-icon-open hidden" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
      </svg>
    </button>

    <div data-accordion-target="content" class="job-accordion-content">
      <p class="job-accordion-content-text"><%= simple_format(truncate(job.description, length: 400, separator: ' ')) %></p>
      <% if policy(job).edit? %>
        <%= link_to "Edit", edit_job_path(job), data: { turbo_frame: "_top" } %>
      <% end %>
      <% if policy(job).archive? %>
        <%= link_to job.archived? ? 'Reopen' : 'Archive', change_status_job_path(job, job: { status: job.archived? ? 'open' : 'archived' }), data: { turbo_method: :patch } %>
      <% end %>
    </div>
  </div>
<% end %>
