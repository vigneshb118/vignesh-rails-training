<%= turbo_frame_tag "company" do %>
<div class="company-card">
  <h2><%= @company.name %></h2>
  <p><%= @company.description %></p>
  <div class="text-center">
    <%= link_to "Edit Company", edit_company_path(@company), data: { turbo_frame: "_top" } %>
  </div>
</div>
<% end %>

<div class="company-jobs-container">
  <h2>Jobs posted by you</h2>
  <% if @company.jobs.any? %>
    <div class="company-jobs-list">
      <% @company.jobs.each do |job| %>
        <%= render "companies/job", job: job %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-500 mb-4">No jobs posted yet.</p>
  <% end %>
  <% if current_user&.user_type == "employer" %>
    <div class="text-center">
      <%= link_to "Post a Job", new_job_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition-colors duration-200 inline-block" %>
    </div>
  <% end %>
</div>