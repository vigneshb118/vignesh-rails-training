<div class="auth-container">
  <div class="card login-card">
    <h1>HireHub</h1>
    <h2>Welcome back</h2>
    <p>Log in to your account to continue</p>
    <br />
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
      </div>

      <div class="field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••" %>
      </div>

      <div class="actions">
        <%= f.submit "Login" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <p class="text-sm text-gray-600">Don't have an account? 
        <%= link_to "Sign up", new_user_registration_path, class: "text-blue-600 hover:text-blue-700 font-medium" %>
      </p>
    </div>
  </div>
</div>
